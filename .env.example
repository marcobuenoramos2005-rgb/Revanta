# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# --- Supabase ---------------------------------------------------------------
# En local: ejecuta `npx supabase start` y copia "API_URL" y "PUBLISHABLE_KEY".
# En producción: Supabase > Project Settings > API Keys.
# Ambas son públicas por diseño; la seguridad la garantizan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

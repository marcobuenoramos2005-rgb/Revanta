# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# --- Supabase ---------------------------------------------------------------
# En local: ejecuta `npx supabase start` y copia "API_URL" y "PUBLISHABLE_KEY".
# En producción: Supabase > Project Settings > API Keys.
# Ambas son públicas por diseño; la seguridad la garantizan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Dirección pública de la app (opcional) ----------------------------------
# Solo hace falta con dominio propio. En local y en Vercel se detecta sola.
# SITE_URL=https://tudominio.com

# --- IA de anuncios (solo servidor) -----------------------------------------
# Clave de la API de Anthropic. SECRETA: nunca la subas a GitHub ni la pegues en un chat.
# No lleva el prefijo NEXT_PUBLIC_, así que nunca llega al navegador.
# Si está vacía, la app no hace ninguna llamada de pago.
ANTHROPIC_API_KEY=

# Pon 1 para usar textos simulados (sin coste) cuando no hay clave. Solo desarrollo y pruebas.
AI_MOCK=1

# Anuncios por usuario cada 24 horas (por defecto 20).
AI_DAILY_LIMIT=20
